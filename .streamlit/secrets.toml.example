# Streamlit Cloud -> Manage app -> Settings -> Secrets (never commit real values)
BASE_URL = "https://qrcodescan.streamlit.app"

# Supabase Postgres - use the *Session pooler* URI (Project -> Connect). QRForge keeps its tables in its own
# `qrforge` schema, so it never touches other apps in the same project. Empty = local SQLite (data lost on Cloud restarts).
DATABASE_URL = "postgresql://postgres.<project-ref>:<DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Email notifications (Gmail: use an App Password, not your normal password)
SMTP_SENDER = "you@gmail.com"
SMTP_PASSWORD = "xxxx xxxx xxxx xxxx"
OWNER_EMAIL = "you@gmail.com"          # receives admin copies of logins / signups
# NOTIFY_USER_LOGIN = "true"           # login alert email to the user
# NOTIFY_OWNER_LOGIN = "true"          # copy to OWNER_EMAIL

# Required. Without a valid key the app, all pages, scan links and the database layer refuse to run.
LICENSE_KEY = "your-license-key"
