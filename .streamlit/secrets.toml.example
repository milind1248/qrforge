# Streamlit Cloud -> App settings -> Secrets (never commit real values)
BASE_URL = "https://qrcodescan.streamlit.app"

# Supabase Postgres. Use the *Connection pooler* string (Project -> Connect -> Session pooler),
# because Streamlit Cloud cannot reach the IPv6-only direct host.
# Format: postgresql://postgres.<project-ref>:<DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# If DATABASE_URL is empty the app falls back to local SQLite (data is lost on Streamlit Cloud restarts).
DATABASE_URL = ""
